# Copy to .env for local development only. Never commit real values.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/lifeline
# Public HTTPS address of the app, no trailing slash
APP_URL=https://your-lifeline-address.example
# From Google Cloud > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed to activate the owner workspace
OWNER_EMAIL=michael@michaelhodomsr.com
# Optional. If blank, the app creates and stores its own key in the database.
SESSION_SECRET=
