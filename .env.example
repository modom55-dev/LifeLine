# Copy to .env for local development only. Never commit real values.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/lifeline
APP_URL=https://your-lifeline-address.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=michael@michaelhodomsr.com
SESSION_SECRET=

# Team sheet the bulletin loads from (defaults to the WLCC Weekly Bulletin sheet)
TEAM_SHEET_ID=

# Connection Card alerts (comma-separated)
ALERT_EMAILS=
ALERT_PHONES=

# Email (Resend). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=WholeLife Community Church <hello@wholelifechurch.org>
EMAIL_REPLY_TO=

# Text messages (Twilio, after carrier registration is approved)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
